# Copy to .env and adjust as needed. Used by docker-compose to configure the
# Postgres containers, and by each server (Properties/launchSettings.json) to
# connect to its own database.

# single-tenant's database. 5433 avoids clashing with a locally-installed
# Postgres already bound to 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=brydon
DB_USER=brydon
DB_PASSWORD=brydon

# patient-portal's database — separate from single-tenant's (5434), since
# they're meant to be independently deployable systems.
PATIENT_PORTAL_DB_HOST=localhost
PATIENT_PORTAL_DB_PORT=5434
PATIENT_PORTAL_DB_NAME=patient_portal
PATIENT_PORTAL_DB_USER=patient_portal
PATIENT_PORTAL_DB_PASSWORD=patient_portal

# Pre-shared key each single-tenant instance sends (as the X-Tenant-Report-Key
# header) when reporting its hashed username directory to patient-portal. Also
# doubles as the HMAC key used to hash usernames before reporting them, so
# this must be identical across patient-portal and every single-tenant
# instance — different keys would hash the same username differently and
# patient-portal wouldn't be able to correlate the same patient across tenants.
TENANT_REPORT_SECRET=dev-only-shared-secret-replace-before-deploying

# Where single-tenant sends its username directory reports on startup.
PATIENT_PORTAL_URL=http://localhost:5009

# Optional: credentials for the demo user seeded on first run when the users
# table is empty. Falls back to demo/password123 if unset.
DEMO_USERNAME=demo
DEMO_PASSWORD=password123

# Which deployment this client/server pair is running as. Each pair lives on
# its own subdomain of a shared domain (client and API reverse-proxied to the
# same origin), e.g. SUBDOMAIN=acme + APP_DOMAIN=example.com -> the server
# treats https://acme.example.com as its own origin: used as the JWT
# issuer/audience and folded into the CORS allow-list. Leave both unset for
# local dev — falls back to http://localhost:5251.
# SUBDOMAIN=acme
# APP_DOMAIN=example.com
