# Copy to .env and adjust as needed. Used by docker-compose to configure the
# Postgres containers, and by each server (Properties/launchSettings.json) to
# connect to its own database.

# single-tenant's database. 5433 avoids clashing with a locally-installed
# Postgres already bound to 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=brydon
DB_USER=brydon
DB_PASSWORD=brydon

# tenant-router's database — separate from single-tenant's (5435), since
# they're meant to be independently deployable systems. Neither patient-portal
# nor marketing-website has a database of its own: both are stateless
# orchestrators that call tenant-router over HTTP to resolve which tenant a
# login belongs to.
TENANT_ROUTER_DB_HOST=localhost
TENANT_ROUTER_DB_PORT=5435
TENANT_ROUTER_DB_NAME=tenant_router
TENANT_ROUTER_DB_USER=tenant_router
TENANT_ROUTER_DB_PASSWORD=tenant_router

# Pre-shared key each single-tenant instance sends (as the X-Tenant-Report-Key
# header) when reporting its hashed username directory to tenant-router — and
# that patient-portal and marketing-website both send when looking one up.
# Also doubles as the HMAC key used to hash usernames, so this must be
# identical across tenant-router, patient-portal, marketing-website, and
# every single-tenant instance — different keys would hash the same username
# differently and tenant-router wouldn't be able to correlate the same
# patient across tenants.
TENANT_REPORT_SECRET=dev-only-shared-secret-replace-before-deploying

# Where single-tenant sends its username directory reports on startup, and
# where patient-portal/marketing-website look a username up to resolve which
# tenant a login belongs to.
TENANT_ROUTER_URL=http://localhost:5236

# Optional: credentials for the demo user seeded on first run when the users
# table is empty. Falls back to demo/password123 if unset.
DEMO_USERNAME=demo
DEMO_PASSWORD=password123

# Which deployment this client/server pair is running as. Each pair lives on
# its own subdomain of a shared domain (client and API reverse-proxied to the
# same origin), e.g. SUBDOMAIN=acme + APP_DOMAIN=example.com -> the server
# treats https://acme.example.com as its own origin: used as the JWT
# issuer/audience and folded into the CORS allow-list. Leave both unset for
# local dev — falls back to http://localhost:5251.
# SUBDOMAIN=acme
# APP_DOMAIN=example.com

# Optional: overrides where OTHER backends (patient-portal or marketing-website,
# relaying a login to this tenant's server) reach this server directly.
# Defaults to the same origin as above, which is correct in production (same
# reverse-proxied origin serves both). Only needed when that public origin
# isn't actually reachable server-to-server — e.g. in Docker, where
# SUBDOMAIN/APP_DOMAIN form a fake public-looking origin but the real address
# is a container hostname like http://tenant1-server:8080 (see
# docker-compose.multi-tenant.yml).
# SELF_URL=http://tenant1-server:8080

# CORS: which client origin each server allows. single-tenant, patient-portal,
# and marketing-website all read the same var name (CLIENT_ORIGIN) but are
# separate processes with separate env — set it to that server's own client's
# dev origin. single-tenant defaults to http://localhost:5173, patient-portal
# to http://localhost:5174, marketing-website to http://localhost:5175.
# tenant-router has no client and doesn't use this at all.
CLIENT_ORIGIN=http://localhost:5173
